{{!-- The maze minigame, shown in place of the dossier on the main page (index.js opens and closes it,
     maze.js runs it). Hidden until opened, so the page's music and buttons stay as they are. --}}
<section class="maze-page hidden" id="mazeView" aria-label="Agentuuri labürint">
    <a class="maze-back" href="/"><i class="bi bi-arrow-left"></i> Tagasi toimiku juurde</a>

    <header class="paper maze-head">
      <div class="maze-kicker">Lisaülesanne · Jõululoos {{year}}</div>
      <h1>Agentuuri labürint</h1>
      <details class="scoreboard" id="scoreboard">
        <summary>
          <span class="scoreboard-title"><i class="bi bi-trophy"></i> Edetabel</span>
          <span class="scoreboard-peek" id="boardPeek"></span>
          <i class="bi bi-chevron-down scoreboard-chevron" aria-hidden="true"></i>
        </summary>
        <ol class="board-list" id="leaderboard"></ol>
        <p class="muted-note" id="boardEmpty">Keegi pole veel mänginud. Ole esimene!</p>
        <div class="unfinished hidden" id="unfinishedBox">
          <h3>Veel teel ukseni</h3>
          <ul class="board-list" id="unfinishedList"></ul>
        </div>
      </details>
    </header>

    <nav class="levels" id="levels" aria-label="Tasemed"></nav>

    <section class="paper maze-play" aria-label="Labürint">
      <div class="maze-status">
        <span><span id="moveCount">0</span> käiku</span>
      </div>
      <div class="board-wrap">
        <svg id="board" class="board" role="img" aria-label="Labürint" xmlns="http://www.w3.org/2000/svg"></svg>
        <div class="win hidden" id="win" role="dialog" aria-live="polite">
          <div class="win-card">
            <div class="win-title">Jõulukera on kohal!</div>
            <div class="win-stars" id="winStars"></div>
            <div id="winText"></div>
            <div class="win-best" id="winBest"></div>
            <div class="win-actions">
              <button type="button" class="button button-small" id="retryButton">Proovi uuesti</button>
              <button type="button" class="button button-small" id="nextButton">Järgmine tase <i class="bi bi-chevron-right"></i></button>
            </div>
          </div>
        </div>
      </div>
      <div class="maze-hint" id="hint" role="status"></div>
      <div class="controls">
        <button type="button" class="tool" id="undoButton"><i class="bi bi-arrow-counterclockwise"></i> Võta tagasi</button>
        <button type="button" class="tool" id="restartButton"><i class="bi bi-arrow-repeat"></i> Alusta otsast</button>
      </div>
    </section>

    <a class="maze-back maze-back-bottom" href="/"><i class="bi bi-arrow-left"></i> Tagasi toimiku juurde</a>
</section>
