<!DOCTYPE html>
<html lang="en">

<head>
    {{> head pageTitle="Sign in · Secret Santa Admin"}}
    <meta name="robots" content="noindex, nofollow">
    <link href="/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/admin-assets/admin.css">
</head>

<body class="login-body">
    <main class="login-card">
        <div class="brand brand-center">
            <span class="brand-mark"><i class="bi bi-gift-fill"></i></span>
            <span class="brand-text">Secret Santa<small>Admin</small></span>
        </div>
        <h1>Sign in</h1>
        {{#if error}}<div class="callout callout-danger"><i class="bi bi-exclamation-octagon"></i><span>{{error}}</span></div>{{/if}}
        <a class="btn btn-primary btn-block" href="/admin/login?next={{next}}"><i class="bi bi-google"></i>Continue with Google</a>
        <a class="login-back" href="/">Back to the site</a>
    </main>
</body>

</html>
