<!DOCTYPE html>
<html>

<head>
  {{> head}}
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
</head>

<body>
  <canvas id="snow"></canvas>
  <div class="bg">
    <main role="main" class="centerer text-center">
      {{> hoverIcons}}
      {{#if isAdmin}}
      {{> adminheader}}
      {{/if}}
      {{#if encryptionWithCode}}
      <div class="inputContainer" id="inputContainer">
        <div class="input-group mb-3">
          <input type="{{inputType}}" class="form-control" id="userCode" placeholder="Kood" value="{{prefill}}">
          <button class="btn btn-outline-secondary" type="button" id="toggleUserCodeVisibility">
            <i class="bi bi-eye"></i>
          </button>
        </div>
        <br />
        <div>
          <button class="button" id="submit" onclick="submitCode()">Kuva nimi</button>
        </div>
      </div>
      {{/if}}
      {{#if encryptionWithCdoc  }}
      <div>
        <button onclick="window.open('/cdoc', '_blank')" class="button">CDOC</button>
      </div>
      {{/if}}
      {{#unless loggedIn}}
      <div id="authContainer" class="authContainer">
        <button id="googleAuthButton" class="gsi-material-button" onclick="location.href = '/auth/google'">
          <div class="gsi-material-button-state"></div>
          <div class="gsi-material-button-content-wrapper">
            <div class="gsi-material-button-icon">
              <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"
                xmlns:xlink="http://www.w3.org/1999/xlink" style="display: block;">
                <path fill="#EA4335"
                  d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z">
                </path>
                <path fill="#4285F4"
                  d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z">
                </path>
                <path fill="#FBBC05"
                  d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z">
                </path>
                <path fill="#34A853"
                  d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z">
                </path>
                <path fill="none" d="M0 0h48v48H0z"></path>
              </svg>
            </div>
            <span class="gsi-material-button-contents">Autendi Google kontoga</span>
            <span style="display: none;">Autendi Google kontoga</span>
          </div>
        </button>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-copy"
        viewBox="0 0 16 16">

        <div id="webViewWarning" class="hidden">
          Messengerist otse avades ei saa kasutada Google autentimist. Kopeeri link ja ava brauseris.<br />
          <div id="copyContainer" onclick="copyTextToClipboard(window.location.href)">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-copy"
              viewBox="0 0 16 16">
              <path fill-rule="evenodd"
                d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z" />
            </svg>
            <span id="pageUrl"></span>
          </div>
        </div>
        {{/unless}}
        <div id="nameContainer" class="nameContainer white-container hidden">
          <h1 id="welcomeHeader">Tere, <span id="userName"></span>!</h1>
          <h3>Sinu kingisaaja on:</h3>
          <div id="gifteeNameDisplay" class="gifteeNameDisplay">
            <!-- Giftee name will be inserted here -->
          </div>
        </div>
        <div id="audioContainer" class="audioContainer white-container hidden">
          <!-- YouTube player will be inserted here -->
        </div>
        <div id="onlineUsersContainer" class="white-container hidden" style="margin-top: 20px;">
          <h5>🟢 Praegu online</h5>
          <div id="onlineUsersList" style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 10px;">
            <!-- Online users will be inserted here -->
          </div>
        </div>
        <div id="songShareContainer" class="white-container hidden" style="margin-top: 20px;">
          <h4>🎵 Jaga laulu</h4>
          <div class="input-group mb-3" style="max-width: 500px; margin: 0 auto;">
            <input type="text" class="form-control" id="songUrlInput" placeholder="https://www.youtube.com/watch?v=...">
            <button class="btn btn-outline-light" type="button" onclick="handleSaveSongShared()">Jaga</button>
          </div>
        </div>
        <div id="logoutContainer" class="logoutContainer hidden">
          <a href="/auth/logout">
            <svg xmlns="http://www.w3.org/2000/svg" height="2em"
              viewBox="0 0 512 512"><!--! Font Awesome Free 6.4.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2023 Fonticons, Inc. -->
              <path
                d="M377.9 105.9L500.7 228.7c7.2 7.2 11.3 17.1 11.3 27.3s-4.1 20.1-11.3 27.3L377.9 406.1c-6.4 6.4-15 9.9-24 9.9c-18.7 0-33.9-15.2-33.9-33.9l0-62.1-128 0c-17.7 0-32-14.3-32-32l0-64c0-17.7 14.3-32 32-32l128 0 0-62.1c0-18.7 15.2-33.9 33.9-33.9c9 0 17.6 3.6 24 9.9zM160 96L96 96c-17.7 0-32 14.3-32 32l0 256c0 17.7 14.3 32 32 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-64 0c-53 0-96-43-96-96L0 128C0 75 43 32 96 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32z" />
            </svg>
          </a>
        </div>
    </main>
  </div>

  <script src="/js/index.js"></script>
  <script src="/js/snow.js"></script>
  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
  <script src="/js/song.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</body>

</html>