<!DOCTYPE html>
<html>

<head>
  {{> head}}
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/dossier.css">
  <link rel="stylesheet" href="/css/maze.css">
  <link href="/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="/vendor/toastify/toastify.css">
</head>

<body data-logged-in="{{#if loggedIn}}true{{else}}false{{/if}}" data-santa-clips="{{santaClips}}">
  <canvas id="snow"></canvas>
  <div class="bg">
    {{#> hoverIcons}}
      {{!-- The sound switch (audio.js shows it once the dossier opens). --}}
      <button type="button" class="sound-toggle hidden" id="soundToggle" aria-label="Lülita heli välja" title="Heli">
        <i class="bi bi-volume-up-fill"></i>
      </button>
      {{!-- Shown once signed in (index.js). --}}
      <form method="post" action="/auth/logout" id="logoutContainer" class="hidden">
        <button type="submit" aria-label="Logi välja" title="Logi välja"><i class="bi bi-box-arrow-right"></i></button>
      </form>
    {{/hoverIcons}}
    {{#if isAdmin}}
    {{!-- Top-left corner, admins only: the panel link (the page icons are centred at the top). --}}
    <div class="corner-left">
      {{> adminheader}}
    </div>
    {{/if}}
    <main role="main" class="centerer text-center">

      {{#if encryptionWithCode}}
      <div class="briefing" id="inputContainer">
        {{#if waiting}}
        {{!-- Signed in, but not in a draw yet: no code, so nothing to open (the button would only fail). --}}
        <div class="briefing-greeting">Tere, {{userName}}!</div>
        <h2 class="briefing-title briefing-headline">
          <i class="bi bi-hourglass-split"></i> Vara veel, jõuluvana alles mõtleb.
        </h2>
        {{else}}
        {{#if loggedIn}}
        <div class="briefing-greeting">Tere, {{userName}}!</div>
        <h2 class="briefing-title briefing-headline">
          <i class="bi bi-envelope-paper-fill"></i> Uus missioon jõuluvanalt
        </h2>
        {{else}}
        <h2 class="briefing-title">Sisesta oma kood</h2>
        {{/if}}
        <div class="input-group mb-3 {{#if loggedIn}}hidden{{/if}}" id="codeInputGroup">
          <input type="{{inputType}}" class="form-control" id="userCode" placeholder="Kood" value="{{prefill}}">
          <button class="btn btn-outline-secondary" type="button" id="toggleUserCodeVisibility">
            <i class="bi bi-eye"></i>
          </button>
        </div>
        <div class="briefing-error {{#unless error}}hidden{{/unless}}" id="briefingError">{{error}}</div>
        <div class="briefing-action">
          <button class="button" id="submit">
            {{#if loggedIn}}Ava infopakk{{else}}Sisene{{/if}}
          </button>
        </div>
        {{/if}}
      </div>
      {{/if}}

      {{#unless loggedIn}}
      <div id="authContainer" class="authContainer">
        <button id="googleAuthButton" class="gsi-material-button" type="button">
          <div class="gsi-material-button-state"></div>
          <div class="gsi-material-button-content-wrapper">
            <div class="gsi-material-button-icon">
              <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"
                xmlns:xlink="http://www.w3.org/1999/xlink" style="display: block;">
                <path fill="#EA4335"
                  d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z">
                </path>
                <path fill="#4285F4"
                  d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z">
                </path>
                <path fill="#FBBC05"
                  d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z">
                </path>
                <path fill="#34A853"
                  d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z">
                </path>
                <path fill="none" d="M0 0h48v48H0z"></path>
              </svg>
            </div>
            <span class="gsi-material-button-contents">Autendi Google kontoga</span>
            <span style="display: none;">Autendi Google kontoga</span>
          </div>
        </button>
      </div>
      <div id="webViewWarning" class="hidden">
        Messengerist otse avades ei saa kasutada Google autentimist. Kopeeri link ja ava brauseris.<br />
        <div id="copyContainer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-copy"
            viewBox="0 0 16 16">
            <path fill-rule="evenodd"
              d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z" />
          </svg>
          <span id="pageUrl"></span>
        </div>
      </div>
      {{/unless}}

      <!-- The classified file, filled in by index.js after the name is resolved -->
      <div id="dossier" class="dossier hidden">
        <div class="dossier-folder">
          <div class="dossier-tab">Toimik nr <span id="dossierNumber"></span></div>
          <div class="dossier-paper">
            <div class="stamp" id="dossierStamp">Salajane</div>
            <div class="dossier-kicker">Jõululoos {{year}} · Operatsioon Kinkekott</div>
            <div class="dossier-line"><span class="label">Agent:</span> <span id="dossierAgent"></span></div>
            <div class="dossier-target">
              <div class="label">Sinu kingisaaja</div>
              <div class="target-name" id="recipient"></div>
            </div>
            <div class="dossier-body">
              <div class="polaroid" id="dossierPhotoFrame">
                <div class="tape"></div>
                <img id="dossierPhoto" class="hidden" alt="">
                <div class="polaroid-placeholder" id="dossierPhotoPlaceholder">
                  <i class="bi bi-person-fill"></i>
                  <span class="polaroid-stamp">pildistamiskatsed ebaõnnestusid</span>
                </div>
              </div>
              <div class="dossier-fields">
                <div class="dossier-line hidden" id="dossierCodenameRow">
                  <span class="label">Koodnimi:</span> <span id="dossierCodename"></span>
                </div>
                <div class="dossier-section hidden" id="dossierBriefRow">
                  <div class="label">Missioon:</div>
                  <p id="dossierBrief"></p>
                </div>
                <div class="dossier-section" id="dossierStatsRow">
                  <div class="label">Agentuuri andmed:</div>
                  <ul class="dossier-stats" id="dossierStats"></ul>
                </div>
                <div class="dossier-section hidden" id="dossierFactsRow">
                  <div class="label">Teadaolevad faktid:</div>
                  <ul id="dossierFacts"></ul>
                </div>
                <div class="dossier-section dossier-bonus-row">
                  <a class="dossier-bonus" href="/labyrint"><i class="bi bi-signpost-split"></i> Lisaülesanne: agentuuri labürint</a>
                </div>
              </div>
            </div>
            <div class="dossier-footer">
              <div class="speaking hidden" id="speakingIndicator"><i class="bi bi-soundwave"></i> Jõuluvana räägib…</div>
              <button class="dossier-replay hidden" id="replayButton">
                <i class="bi bi-volume-up-fill"></i> Kuula jõuluvana
              </button>
              <div class="dossier-disclaimer">See toimik hävib ise 5 sekundi pärast. Nali. Hoia alles.</div>
            </div>
          </div>
        </div>
      </div>

      {{> maze}}

      <audio id="briefingPlayer" preload="auto" playsinline></audio>
      <audio hidden id="player" playsinline loop>
        <source src="/audio/music.mp3" type="audio/mpeg">
      </audio>

    </main>
  </div>

  <script src="/js/track.js"></script>
  <script src="/js/audio.js"></script>
  <script src="/js/snow.js"></script>
  <script src="/js/maze-engine.js"></script>
  <script src="/js/maze.js"></script>
  <script src="/js/index.js"></script>
  <script src="/vendor/toastify/toastify.js"></script>
</body>

</html>
