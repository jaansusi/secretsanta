NODE_ENV=development
# Absolute public URL of the app, including the port when it is not 80/443.
# Used for the Google OAuth callback and the CSRF origin check; https enables Secure cookies + HSTS.
HOST=http://localhost:3000
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookies. Required, at least 32 random characters:
#   openssl rand -base64 48
# Rotating it logs everyone out.
COOKIE_SECRET=

ADMIN_EMAIL=

# Number of reverse proxies in front of the app (e.g. 1 behind an ingress / load balancer), so that
# rate limiting sees the real client IP. Leave empty when the app is reached directly.
TRUST_PROXY=
# error | warn | info | debug. Defaults to info in production, debug otherwise.
LOG_LEVEL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=secretsanta
DB_USER=secret
DB_PASSWORD=
# Set DB_SSL=true to require TLS to the database (certificate verified); DB_SSL_CA for a private CA (PEM).
DB_SSL=
DB_SSL_CA=
# Log every SQL statement (local debugging only: statements contain decryption codes).
DB_LOGGING=false
# Store a plaintext copy of each assignment (giftingToDebug). Only honoured when NODE_ENV=development.
STORE_DEBUG_ASSIGNMENTS=false

PGADMIN_EMAIL=local@d.ev
PGADMIN_PASS=
PGADMIN_PORT=8888


# Must be https; its origin is the only one allowed to be framed (Content-Security-Policy frame-src).
GOOGLE_DOC_LETTER_LINK=""

# Santa audio clips are pre-generated with `yarn santa-audio` (not used by the app at runtime).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Sz0tRTEpybtDJ9ru2kgD
ELEVENLABS_MODEL_ID=eleven_v4
# Optional voice settings: stability 0..1, similarity 0..1, speed 0.7..1.2
#ELEVENLABS_STABILITY=0.5
#ELEVENLABS_SIMILARITY=0.75
#ELEVENLABS_SPEED=0.95
