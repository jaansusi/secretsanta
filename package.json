{
  "name": "secretsanta",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "santa-audio": "node --env-file=.env scripts/santa-audio/generate.mjs",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^12",
    "@nestjs/config": "^12",
    "@nestjs/core": "^12",
    "@nestjs/passport": "^12",
    "@nestjs/platform-express": "^12",
    "@nestjs/sequelize": "^12",
    "@nestjs/throttler": "^6.7.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4",
    "express-handlebars": "^9.0.4",
    "helmet": "^8.3.0",
    "nest-winston": "^2",
    "passport": "^0.7",
    "passport-google-oauth20": "^2.0",
    "pg": "^8.23",
    "reflect-metadata": "^0.2",
    "rxjs": "^7.8",
    "sequelize": "^6.37",
    "sequelize-typescript": "^2.1",
    "toastify-js": "^1.12.0",
    "winston": "^3.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12",
    "@nestjs/schematics": "^12",
    "@nestjs/testing": "^12",
    "@types/cookie-parser": "^1.4",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/node": "^26",
    "@types/passport-google-oauth20": "^2.0",
    "@types/validator": "^13.15",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5.5",
    "globals": "^17.14.0",
    "jest": "^30",
    "prettier": "^3.9",
    "ts-jest": "^29.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "resolutions": {
    "sequelize/uuid": "^11.1.1",
    "**/@jest/reporters/glob": "^14.0.4",
    "**/jest-config/glob": "^14.0.4",
    "**/jest-runtime/glob": "^14.0.4",
    "**/test-exclude/glob": "^14.0.4"
  }
}
